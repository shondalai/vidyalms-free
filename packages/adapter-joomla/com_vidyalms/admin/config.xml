<?xml version="1.0" encoding="utf-8"?>
<!-- Joomla ACL remains host-owned. Runtime configuration is edited in VidyaLMS Settings. -->
<config>


    <!--
      The permissions fieldset sits at the top level of <config>, not inside a
      <fields name="params"> group: com_config binds the rules field from a
      flat fieldset, which is what every core component ships.
    -->
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL"
              description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules"
               validate="rules" component="com_vidyalms" section="component" />
    </fieldset>
</config>
